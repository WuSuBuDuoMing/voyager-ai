.diary-card {
  display: flex;
  flex-direction: row;
  padding-bottom: var(--spacing-lg);
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: var(--spacing-md);
  width: 30rpx;
}

.node-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  flex-shrink: 0;
  margin-top: 8rpx;
}

.node-line {
  flex: 1;
  width: 4rpx;
  background: var(--border-color);
  margin-top: var(--spacing-xs);
}

.diary-content {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: 0 2rpx 12rpx var(--shadow-color);
  transition: all 0.3s ease;
}

.diary-content:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.diary-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.diary-date {
  font-size: var(--font-sm);
  color: var(--text-hint);
}

.diary-mood {
  font-size: 40rpx;
}

.diary-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--spacing-sm);
}

.diary-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.8;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  margin-bottom: var(--spacing-md);
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.photo-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
}

.diary-stats {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.stat {
  font-size: var(--font-xs);
  color: var(--text-hint);
}
