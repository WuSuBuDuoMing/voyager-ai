.expense-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--border-color);
  transition: all 0.2s ease;
}

.expense-item:active {
  opacity: 0.7;
}

.expense-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--brand-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.expense-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.expense-desc {
  font-size: var(--font-md);
  color: var(--text-primary);
  font-weight: 500;
}

.expense-date {
  font-size: var(--font-xs);
  color: var(--text-hint);
  margin-top: 4rpx;
}

.expense-amount {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--danger);
}
