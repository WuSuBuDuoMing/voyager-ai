/* trip-card 旅行卡片样式 */

/* 卡片容器 */
.trip-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx var(--shadow-color);
  margin-bottom: var(--spacing-md);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.trip-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx var(--shadow-color);
}

/* 封面图片区域 */
.card-cover {
  position: relative;
  width: 100%;
  height: 320rpx;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

/* 渐变遮罩 */
.cover-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 160rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  pointer-events: none;
}

/* 状态标签 */
.status-tag {
  position: absolute;
  top: var(--spacing-md);
  left: var(--spacing-md);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  color: #FFFFFF;
  font-weight: 600;
}

/* 人数标签 */
.people-tag {
  position: absolute;
  top: var(--spacing-md);
  right: var(--spacing-md);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8rpx);
}

/* 卡片内容 */
.card-body {
  padding: var(--spacing-lg);
}

/* 目的地名称 */
.destination {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 日期范围 */
.date-range {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: var(--spacing-md);
}

.date-icon {
  font-size: var(--font-sm);
}

.date-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 预算区域 */
.budget-section {
  margin-bottom: var(--spacing-sm);
}

.budget-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.budget-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.budget-amount {
  font-size: var(--font-sm);
  color: var(--text-primary);
  font-weight: 500;
}

/* 进度条 */
.progress-bar {
  width: 100%;
  height: 8rpx;
  background: var(--border-color);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
  background: var(--brand-primary);
  transition: width 0.6s ease;
}

/* 打包进度区域 */
.packing-section {
  margin-top: var(--spacing-sm);
}

.packing-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.packing-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.packing-percent {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: 500;
}

.packing-fill {
  background: var(--info);
}
