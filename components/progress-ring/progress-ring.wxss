/* progress-ring 进度环样式 */

/* 进度环容器 */
.ring {
  position: relative;
  display: inline-block;
}

/* 背景圆环 */
.ring-bg {
  position: absolute;
  top: 0;
  left: 0;
}

/* 右半圆容器 */
.ring-right {
  position: absolute;
  top: 0;
  overflow: hidden;
}

/* 左半圆容器 */
.ring-left {
  position: absolute;
  top: 0;
  overflow: hidden;
}

/* 半圆基础样式 */
.ring-half {
  position: absolute;
  top: 0;
  transform-origin: left center;
  transition: transform 0.6s ease;
}

/* 右半圆从左侧中心旋转 */
.ring-right-half {
  left: 0;
  transform-origin: left center;
}

/* 左半圆从右侧中心旋转 */
.ring-left-half {
  right: 0;
  left: auto;
  transform-origin: right center;
}

/* 内部文字区域 */
.ring-inner {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--bg-card);
  z-index: 1;
}

/* 百分比数字 */
.ring-percent {
  font-size: var(--font-lg);
  font-weight: 700;
  line-height: 1.2;
}

/* 附加文字 */
.ring-text {
  font-size: var(--font-xs);
  color: var(--text-hint);
  margin-top: 2rpx;
}
