.place-card {
  display: flex;
  flex-direction: row;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--spacing-md);
  box-shadow: 0 2rpx 12rpx var(--shadow-color);
  transition: all 0.3s ease;
}

.place-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.place-image {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.place-info {
  flex: 1;
  padding: var(--spacing-md);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.place-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-xs);
}

.place-name {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: var(--spacing-sm);
}

.place-meta {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-sm);
}

.rating {
  display: flex;
  align-items: center;
}

.star {
  color: #F59E0B;
  font-size: var(--font-sm);
  margin-right: 4rpx;
}

.rating-num {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 600;
}

.price {
  font-size: var(--font-sm);
  color: var(--brand-primary);
  font-weight: 600;
}

.price.free {
  color: var(--success);
}

.place-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
}

.visited-btn {
  gap: 6rpx;
}

.visited-text {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}

.visited-btn.active .visited-text {
  color: var(--success);
}
