/* day-plan-card 每日行程卡片样式 */

/* 卡片容器 */
.day-card {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
  margin-bottom: var(--spacing-md);
  overflow: hidden;
  transition: transform 0.2s ease;
}

.day-card:active {
  transform: scale(0.98);
}

/* 日期徽章 - 左侧竖条 */
.day-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  min-height: 200rpx;
  background: var(--brand-primary);
  color: #FFFFFF;
  flex-shrink: 0;
}

.day-number {
  font-size: var(--font-xl);
  font-weight: 700;
}

.day-date {
  font-size: var(--font-xs);
  margin-top: 4rpx;
  opacity: 0.9;
}

/* 卡片主体内容 */
.day-body {
  flex: 1;
  padding: var(--spacing-lg);
  min-width: 0;
}

/* 日期标题 */
.day-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 时段区块 */
.period-section {
  margin-bottom: var(--spacing-sm);
  padding: var(--spacing-sm);
  background: var(--bg-primary);
  border-radius: var(--radius-md);
}

.period-section:last-of-type {
  margin-bottom: 0;
}

/* 时段头部 */
.period-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.period-emoji {
  font-size: var(--font-md);
}

.period-label {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-secondary);
}

/* 时段内容 */
.period-content {
  padding-left: 4rpx;
}

.period-activity {
  font-size: var(--font-md);
  color: var(--text-primary);
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.period-location {
  font-size: var(--font-xs);
  color: var(--text-hint);
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部信息栏 */
.day-footer {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--border-color);
}

.footer-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.footer-icon {
  font-size: var(--font-sm);
}

.footer-text {
  font-size: var(--font-xs);
  color: var(--text-secondary);
}
