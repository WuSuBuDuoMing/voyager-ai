.packing-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-lg) var(--spacing-md);
}

.header-left {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-primary);
}

.progress-text {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  margin-top: var(--spacing-xs);
}

.progress-ring {
  width: 120rpx;
  height: 120rpx;
}

.ring-bg {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: relative;
  overflow: hidden;
}

.ring-fill {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.ring-inner {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border-radius: 50%;
  background: var(--bg-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-text {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--brand-primary);
}

.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin: 0 var(--spacing-md) var(--spacing-md);
  box-shadow: 0 2rpx 12rpx var(--shadow-color);
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: var(--text-primary);
}

.stats-item.packed .stats-num {
  color: var(--brand-primary);
}

.stats-item.unpacked .stats-num {
  color: var(--warning);
}

.stats-label {
  font-size: var(--font-xs);
  color: var(--text-hint);
  margin-top: 4rpx;
}

.add-item-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin: 0 var(--spacing-md) var(--spacing-md);
}

.add-input {
  flex: 1;
  padding: var(--spacing-md);
  background: var(--bg-card);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  color: var(--text-primary);
}

.category-picker {
  width: 72rpx;
  height: 72rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.add-btn {
  background: var(--brand-primary);
  color: #FFFFFF;
  padding: var(--spacing-md) var(--spacing-lg);
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  font-weight: 600;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: var(--spacing-md);
}

.filter-tabs {
  display: flex;
  padding: 0 var(--spacing-md);
  gap: var(--spacing-sm);
}

.filter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--bg-card);
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: var(--brand-primary);
  color: #FFFFFF;
  font-weight: 600;
}

.packing-list {
  padding: 0 var(--spacing-md);
}
