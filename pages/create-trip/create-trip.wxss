/**
 * pages/create-trip/create-trip.wxss 创建旅行页样式
 */

/* 页面容器 */
.page {
  min-height: 100vh;
  background: var(--bg-primary);
  position: relative;
}

.container {
  padding: var(--spacing-md);
  padding-bottom: 0;
}

/* ========== 表单区块 ========== */
.form-section {
  margin-bottom: var(--spacing-lg);
}

.form-label {
  margin-bottom: var(--spacing-sm);
}

/* ========== 输入框容器 ========== */
.input-wrap {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 8rpx var(--shadow-color);
  border: 2rpx solid var(--border-color);
  transition: border-color 0.3s ease;
}

.input-wrap:focus-within {
  border-color: var(--brand-primary);
}

.form-input {
  font-size: var(--font-md);
  color: var(--text-primary);
  width: 100%;
  background: transparent;
}

.form-textarea {
  font-size: var(--font-md);
  color: var(--text-primary);
  width: 100%;
  min-height: 120rpx;
  background: transparent;
}

.currency-prefix {
  margin-right: 12rpx;
}

.picker-text {
  min-height: 40rpx;
  line-height: 40rpx;
}

/* ========== 日期行 ========== */
.date-row {
  gap: 16rpx;
}

/* ========== 步进器 ========== */
.stepper-wrap {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 20rpx 28rpx;
  box-shadow: 0 2rpx 8rpx var(--shadow-color);
  justify-content: center;
  gap: 40rpx;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  font-size: 36rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.stepper-btn:active {
  transform: scale(0.9);
}

.stepper-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.stepper-value {
  min-width: 80rpx;
  text-align: center;
}

/* ========== 选项药丸网格 ========== */
.pill-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pill-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  font-size: var(--font-sm);
  font-weight: 500;
  background: var(--bg-card);
  color: var(--text-secondary);
  border: 2rpx solid var(--border-color);
  box-shadow: 0 1rpx 4rpx var(--shadow-color);
  transition: all 0.2s ease;
}

.pill-item.active {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  border-color: var(--brand-primary);
  box-shadow: 0 2rpx 12rpx rgba(7, 193, 96, 0.2);
}

.pill-item:active {
  transform: scale(0.95);
}

.pace-pill {
  min-width: 160rpx;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx var(--spacing-md);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-secondary);
  box-shadow: 0 -2rpx 12rpx var(--shadow-color);
  z-index: 100;
}

.generate-btn {
  background: linear-gradient(135deg, #07C160, #06AD56, #059A4A);
  color: #FFFFFF;
  font-size: var(--font-lg);
  padding: 28rpx 0;
  border-radius: var(--radius-lg);
}

.generate-btn:active {
  background: linear-gradient(135deg, #06AD56, #059A4A, #048A3F);
}

/* ========== AI 生成中遮罩 ========== */
.generating-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 999;
  flex-direction: column;
}

.generating-icon {
  font-size: 120rpx;
}

.generating-title {
  color: #FFFFFF;
}

.generating-desc {
  color: rgba(255, 255, 255, 0.7);
}

.generating-dots {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.generating-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  animation: dotPulse 1.2s infinite;
}

.generating-dots .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.generating-dots .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotPulse {
  0%, 80%, 100% {
    opacity: 0.3;
    transform: scale(0.8);
  }
  40% {
    opacity: 1;
    transform: scale(1.2);
  }
}
