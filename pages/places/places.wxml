<view class="container {{isDarkMode ? 'dark' : ''}}">
  <!-- 头部 -->
  <view class="page-header">
    <text class="page-title">景点清单</text>
    <text class="page-subtitle" wx:if="{{destination}}">{{destination}}</text>
  </view>

  <!-- 筛选标签 -->
  <scroll-view class="filter-scroll" scroll-x enable-flex>
    <view class="filter-tabs">
      <view
        class="filter-tab {{activeFilter === item ? 'active' : ''}}"
        wx:for="{{filterTabs}}"
        wx:key="*this"
        data-tab="{{item}}"
        bind:tap="onFilterTap"
      >
        <text>{{item}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 统计行 -->
  <view class="stats-row" wx:if="{{!loading}}">
    <view class="stat-item">
      <text class="stat-num">{{stats.total}}</text>
      <text class="stat-label">全部景点</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.favorited}}</text>
      <text class="stat-label">已收藏</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num">{{stats.visited}}</text>
      <text class="stat-label">已去过</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <loading-state wx:if="{{loading}}" text="加载景点中..." />

  <!-- 景点列表 -->
  <view class="places-list" wx:elif="{{filteredPlaces.length > 0}}">
    <place-card
      wx:for="{{filteredPlaces}}"
      wx:key="id"
      place="{{item}}"
      bind:tap="onPlaceTap"
      bind:favorite="onFavorite"
      bind:visited="onVisited"
    />
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{!loading && filteredPlaces.length === 0}}"
    icon="📍"
    title="暂无景点"
    subtitle="该分类下还没有景点，试试其他分类吧"
  />
</view>
