<view class="container {{isDarkMode ? 'dark' : ''}}">
  <!-- 头部个人资料 -->
  <view class="profile-header">
    <view class="avatar" bind:tap="onUsernameTap">
      <text class="avatar-emoji">{{avatarEmoji}}</text>
    </view>
    <text class="username" bind:tap="onUsernameTap">{{username}}</text>
    <text class="user-hint">点击修改昵称</text>

    <view class="user-stats">
      <view class="user-stat-item">
        <text class="user-stat-num">{{tripCount}}</text>
        <text class="user-stat-label">次旅行</text>
      </view>
      <view class="user-stat-divider"></view>
      <view class="user-stat-item">
        <text class="user-stat-num">{{destinationCount}}</text>
        <text class="user-stat-label">个目的地</text>
      </view>
      <view class="user-stat-divider"></view>
      <view class="user-stat-item">
        <text class="user-stat-num">{{totalDays}}</text>
        <text class="user-stat-label">天在路上</text>
      </view>
    </view>
  </view>

  <!-- 旅行设置 -->
  <view class="menu-section">
    <view class="section-label">旅行设置</view>
    <view class="card menu-card">
      <view class="menu-item">
        <view class="menu-left">
          <text class="menu-icon">🌙</text>
          <text class="menu-text">暗黑模式</text>
        </view>
        <switch checked="{{darkMode}}" color="#07C160" bind:change="onDarkModeToggle" />
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bind:tap="onCurrencyTap">
        <view class="menu-left">
          <text class="menu-icon">💰</text>
          <text class="menu-text">默认货币</text>
        </view>
        <view class="menu-right">
          <text class="menu-value">{{defaultCurrency}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="menu-section">
    <view class="section-label">数据管理</view>
    <view class="card menu-card">
      <view class="menu-item" bind:tap="onClearCache">
        <view class="menu-left">
          <text class="menu-icon">🗑</text>
          <text class="menu-text">清除缓存</text>
        </view>
        <view class="menu-right">
          <text class="menu-value">{{cacheSize}} KB</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bind:tap="onExportData">
        <view class="menu-left">
          <text class="menu-icon">📤</text>
          <text class="menu-text">导出数据</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="menu-section">
    <view class="section-label">关于</view>
    <view class="card menu-card">
      <view class="menu-item" bind:tap="onVersionTap">
        <view class="menu-left">
          <text class="menu-icon">ℹ️</text>
          <text class="menu-text">版本信息</text>
        </view>
        <view class="menu-right">
          <text class="menu-value">v{{version}}</text>
          <text class="menu-arrow">›</text>
        </view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bind:tap="onHelpTap">
        <view class="menu-left">
          <text class="menu-icon">❓</text>
          <text class="menu-text">使用帮助</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">›</text>
        </view>
      </view>
      <view class="menu-divider"></view>
      <view class="menu-item" bind:tap="onFeedbackTap">
        <view class="menu-left">
          <text class="menu-icon">💬</text>
          <text class="menu-text">意见反馈</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部版本 -->
  <view class="footer">
    <text class="footer-text">AI 旅行计划助手 v{{version}}</text>
  </view>
</view>
